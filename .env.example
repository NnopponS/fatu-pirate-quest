# ===== Frontend (Vite) =====
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Secret used to sign/verify QR codes (any random string, e.g. run: openssl rand -hex 32)
VITE_CHECKIN_SECRET="replace-me"

# Firebase Realtime Database URL
# Format: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DB_URL="https://<your-project>-default-rtdb.asia-southeast1.firebasedatabase.app"

# Supabase project credentials (find in Supabase Dashboard → Settings → API)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_URL="https://<your-supabase-project-id>.supabase.co"
